   reactStrictMode: true,
+  // Traces the minimal set of files/dependencies each page actually needs
+  // and emits a self-contained `.next/standalone` server — without this,
+  // the production image would have to ship the entire node_modules tree
+  // (including every devDependency's transitive deps) instead of a pruned
+  // ~50MB runtime. This is what the Dockerfile's runtime stage copies.
+  output: 'standalone',
   // Server-side fetches (SSR pages, route handlers) call the API directly.
   // Keep the base URL server-only where possible; NEXT_PUBLIC_API_URL exists
   // only because client components (PurchaseButton, AuthContext) also need it.
