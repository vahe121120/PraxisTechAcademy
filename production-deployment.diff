+++ b/ops/backup/entrypoint.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+set -eu
+
+# -----------------------------------------------------------------------------
+# Renders a busybox crontab from BACKUP_SCHEDULE_CRON and runs the cron
+# daemon in the foreground (PID 1, so `docker stop` sends it SIGTERM
+# directly and container lifecycle/logging behave normally).
+#
+# WHY A GENERATED ENV FILE INSTEAD OF PUTTING SECRETS DIRECTLY IN THE
+# CRONTAB LINE: cron job definitions live in a file on disk
+# (/etc/crontabs/backup) that anyone with read access to the container's
+# filesystem can view — including via `docker exec cat`. Writing
+# DATABASE_URL (which contains the database password) into that file
+# directly means the secret exists in two places instead of one. Instead,
+# each scheduled run re-sources a single small env file that already has
+# restrictive permissions, and the crontab line itself contains no secret
+# material at all.
+# -----------------------------------------------------------------------------
+
+if [ -z "${DATABASE_URL:-}" ]; then
+  echo "[backup] FATAL: DATABASE_URL is not set." >&2
+  exit 1
+fi
+
+: "${BACKUP_RETENTION_DAYS:=14}"
+: "${BACKUP_SCHEDULE_CRON:=0 3 * * *}"
+
+ENV_FILE=/app/.backup-env
+{
+  echo "export DATABASE_URL='${DATABASE_URL}'"
+  echo "export BACKUP_RETENTION_DAYS='${BACKUP_RETENTION_DAYS}'"
+} > "$ENV_FILE"
+chmod 600 "$ENV_FILE"
+chown backup:backup "$ENV_FILE"
+
+CRONTAB_FILE=/etc/crontabs/backup
+mkdir -p /etc/crontabs
+echo "${BACKUP_SCHEDULE_CRON} . ${ENV_FILE} && /app/backup.sh >> /proc/1/fd/1 2>> /proc/1/fd/2" > "$CRONTAB_FILE"
+chmod 600 "$CRONTAB_FILE"
+
+echo "[backup] Scheduled: '${BACKUP_SCHEDULE_CRON}' (retention: ${BACKUP_RETENTION_DAYS} days)"
+echo "[backup] Running an initial backup now, then handing off to cron."
+# Runs one backup immediately at container start, in addition to the
+# schedule — otherwise a freshly deployed stack has zero backups until the
+# first scheduled time arrives, which could be up to 24h away.
+su -s /bin/sh backup -c ". ${ENV_FILE} && /app/backup.sh"
+
+# `-f`: foreground (required for this to be PID 1's long-running process).
+# `-d 8`: log at debug level to stderr, which lands in `docker logs` — cron
+# running silently with no visibility into whether jobs actually fired is a
+# common way backup failures go unnoticed for weeks.
+exec crond -f -d 8
