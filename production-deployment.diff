+import { Module } from '@nestjs/common';
+import { LoggerModule as PinoLoggerModule } from 'nestjs-pino';
+import { randomUUID } from 'crypto';
+import type { IncomingMessage, ServerResponse } from 'http';
+
+import { AppConfigModule } from './config.module';
+import { AppConfigService } from './app-config.service';
+import { REQUEST_ID_HEADER } from '../common/constants/app.constants';
+
+/**
+ * Replaces Nest's default console `Logger` with pino app-wide, via
+ * `app.useLogger(app.get(Logger))` in main.ts. This is intentionally a
+ * transparent swap, not a rewrite: every existing `new Logger('Context')`
+ * call site across the codebase (every service, every guard added during
+ * the security review — ArcaWebhookGuard, TelegramWebhookGuard, etc.)
+ * keeps working unchanged. What changes is the output format: structured
+ * JSON in production (one object per line — ingestible by any log
+ * aggregator without a parsing rule), human-readable colorized text in
+ * development (via pino-pretty, a devDependency never installed in the
+ * production image).
+ *
+ * WHY THIS REPLACES, RATHER THAN SUPPLEMENTS, THE EXISTING
+ * LoggingInterceptor (`common/interceptors/logging.interceptor.ts`):
+ * it doesn't — that interceptor still owns the one-line-per-request
+ * access log (success + failure, with latency), and its calls to
+ * `this.logger.log(...)` now transparently become structured JSON too,
+ * for free, because it already goes through Nest's `Logger`. This module
+ * additionally enables `pino-http`'s own request/response auto-logging
+ * (`pinoHttp` option below) at `debug` level only, so full request
+ * metadata (headers, response time) is available for deep debugging
+ * without duplicating the interceptor's concise access-log line at
+ * normal operating log levels.
+ */
+@Module({
+  imports: [
+    AppConfigModule,
+    PinoLoggerModule.forRootAsync({
+      imports: [AppConfigModule],
+      inject: [AppConfigService],
+      useFactory: (config: AppConfigService) => ({
+        pinoHttp: {
+          level: config.logLevel,
+
+          // Correlates every log line pino-http emits for a request with
+          // the same request id the app's own RequestIdMiddleware and
+          // AllExceptionsFilter already use — so a single failed request
+          // is findable across both by grepping/filtering one id, not two
+          // different ones from two independent id-generation schemes.
+          genReqId: (req: IncomingMessage, res: ServerResponse) => {
+            const existing = req.headers[REQUEST_ID_HEADER.toLowerCase()];
+            const id = typeof existing === 'string' && existing.trim().length > 0 ? existing : randomUUID();
+            res.setHeader(REQUEST_ID_HEADER, id);
+            return id;
+          },
+
+          // pino-http's own auto request/response logging stays at
+          // 'debug' regardless of the configured base level — the app's
+          // LoggingInterceptor already provides the normal-operation
+          // access log at 'log'/'info'; this is the opt-in, verbose,
+          // full-metadata version for active debugging, not something
+          // that should double up on every request in production by
+          // default.
+          customLogLevel: () => 'debug',
+
+          // --- Redaction --------------------------------------------------
+          // SECURITY: every field here is something that must never reach
+          // a log aggregator in plaintext, full stop — an access token, a
+          // refresh-token cookie, a password, or a webhook shared secret
+          // leaking into logs is equivalent to leaking it outright, since
+          // most log platforms have far broader read-access (support
+          // staff, dashboards, third-party log-drain integrations) than
+          // the database itself does. `pino`'s redact option replaces the
+          // matched value with `[Redacted]` rather than merely omitting
+          // the key, so the shape of the logged object doesn't change —
+          // deliberate, since a log line that silently drops a field is
+          // harder to debug against than one that visibly shows what was
+          // withheld and why.
+          redact: {
+            paths: [
+              'req.headers.authorization',
+              'req.headers.cookie',
+              'req.headers["x-arca-signature"]',
+              'req.headers["x-telegram-bot-api-secret-token"]',
+              'res.headers["set-cookie"]',
+              // Request/response bodies aren't logged by pino-http by
+              // default (only headers + metadata), so this list doesn't
+              // need to cover every DTO field — but any future change
+              // that turns body-logging on for debugging must also
+              // extend this list before shipping, not after.
+              '*.password',
+              '*.newPassword',
+              '*.currentPassword',
+              '*.accessToken',
+              '*.refreshToken',
+              '*.token',
+            ],
+            censor: '[Redacted]',
+          },
+
+          // Structured JSON in production; pretty, colorized, single-line
+          // human output in development. Never pino-pretty in production —
+          // it's not installed there at all (devDependency only), so this
+          // branch is also a hard guarantee, not just a preference.
+          transport: config.isProduction
+            ? undefined
+            : {
+                target: 'pino-pretty',
+                options: {
+                  colorize: true,
+                  singleLine: true,
+                  translateTime: 'HH:MM:ss.l',
+                  ignore: 'pid,hostname',
+                },
+              },
+
+          // Every log line gets both fields so a query against a log
+          // aggregator can filter by environment / service without
+          // relying on which index or stream it landed in.
+          base: { service: 'praxis-api', env: config.env },
+        },
+      }),
+    }),
+  ],
+  exports: [PinoLoggerModule],
+})
+export class LoggerModule {}
