@@ -0,0 +1,22 @@
+import { NextResponse } from "next/server";
+
+/**
+ * Liveness check for the Next.js server process itself — intentionally has
+ * zero dependencies (no call to praxis-api, no env/config read beyond what
+ * Next.js already needs to boot). This mirrors the backend's `/health/live`
+ * vs `/health/ready` split (see Admin_Panel_Backend/src/health): a frontend
+ * container that can't reach the API is a real problem, but it isn't a
+ * reason for the orchestrator to kill and restart *this* container — the
+ * API being down doesn't mean the Next.js server itself is unhealthy, and
+ * treating it that way would turn a backend outage into a frontend restart
+ * storm too. Route handlers are dynamic by default when they read request
+ * data; this one reads none, so Next.js may attempt to statically optimize
+ * it — force-dynamic guarantees every request actually re-executes rather
+ * than serving a cached response from build time, which matters once other
+ * checks (e.g. a build-time-only value) are ever added here.
+ */
+export const dynamic = "force-dynamic";
+
+export function GET(): NextResponse {
+  return NextResponse.json({ status: "ok" }, { status: 200 });
+}
