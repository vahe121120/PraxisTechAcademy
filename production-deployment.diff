index 0000000..e2bfa87
--- /dev/null
+++ b/ops/backup/Dockerfile
@@ -0,0 +1,30 @@
+# syntax=docker/dockerfile:1
+
+# Alpine specifically for its postgresql-client package tracking recent
+# major versions closely, and because busybox's `crond` (included in the
+# base image already) is a small, well-understood scheduler — no reason to
+# pull in a full cron daemon or a third-party scheduling binary for one
+# nightly job.
+FROM alpine:3.20
+
+# postgresql17-client matches the postgres:17-alpine server image used in
+# docker-compose.yml — pg_dump's format is generally forward/backward
+# compatible across nearby major versions, but pinning the client to match
+# the server avoids ever having to think about it.
+RUN apk add --no-cache postgresql17-client bash
+
+RUN addgroup -g 1001 backup && adduser -D -u 1001 -G backup -s /bin/false backup
+
+WORKDIR /app
+COPY backup.sh entrypoint.sh ./
+RUN chmod +x backup.sh entrypoint.sh \
+  && mkdir -p /backups \
+  && chown -R backup:backup /app /backups
+
+# Deliberately stays root at the Dockerfile level: busybox crond needs to
+# write /etc/crontabs/root and, in this minimal image, that's the only
+# writable system crontab location. entrypoint.sh itself drops to the
+# unprivileged `backup` user for the actual pg_dump execution — see its
+# comments. This mirrors a common, narrowly-scoped exception, not a general
+# "run as root" choice for the service.
+ENTRYPOINT ["/app/entrypoint.sh"]
diff --git a/ops/backup/backup.sh b/ops/backup/backup.sh
