diff --git a/.env.example b/.env.example
new file mode 100644
index 0000000..b2fa9e7
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,109 @@
+# -----------------------------------------------------------------------------
+# Production environment for the docker-compose.yml stack at repo root.
+#
+# cp .env.example .env, then fill in every CHANGE_ME value before running
+# `docker compose up`. This file is read by docker-compose.yml via its
+# `${VAR}` interpolation — it is NOT read directly by the application code
+# inside either container (that still reads Admin_Panel_Backend/.env.example
+# and Frontend/praxis-web/.env.example's variable *names*, just supplied via
+# compose's `environment:`/`args:` instead of a mounted .env file). If a
+# variable exists in one of those two per-app files but is missing here,
+# docker-compose.yml's corresponding `environment:` entry resolves to an
+# empty string — check env.validation.ts's Joi schema will reject that at
+# backend boot rather than silently running with e.g. an empty JWT secret.
+#
+# NEVER commit the real .env — it holds live secrets. Only .env.example is
+# tracked in git.
+# -----------------------------------------------------------------------------
+
+# =============================================================================
+# PostgreSQL
+# =============================================================================
+POSTGRES_USER=praxis_app
+# Generate with: openssl rand -base64 32
+POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
+POSTGRES_DB=praxis
+
+# Built from the three values above — used by both the `migrate` service and
+# the running `backend` service. Host is `postgres` (the compose service
+# name; Docker's internal DNS resolves it), not `localhost` — a very common
+# copy-paste mistake when adapting a local .env into this one.
+#
+# DATABASE_URL and DIRECT_URL are identical here because this compose file
+# has the app connect straight to Postgres with no pooler in front of it. If
+# a pooler (PgBouncer / RDS Proxy / Supabase's pooler) is introduced later,
+# DATABASE_URL should point at the pooler and DIRECT_URL must keep pointing
+# directly at Postgres — `prisma migrate deploy` requires a direct,
+# non-pooled connection. See docs/MIGRATION_STRATEGY.md.
+DATABASE_URL=postgresql://praxis_app:CHANGE_ME_use_openssl_rand_base64_32@postgres:5432/praxis?schema=public
+DIRECT_URL=postgresql://praxis_app:CHANGE_ME_use_openssl_rand_base64_32@postgres:5432/praxis?schema=public
+
+# =============================================================================
+# Backend (Admin_Panel_Backend) — see its own .env.example for per-value
+# explanations; only the values themselves live here.
+# =============================================================================
+LOG_LEVEL=info
+
+# Comma-separated, no wildcard. Must be the frontend's real public origin —
+# a mismatch here doesn't fail loudly, it just makes every browser request
+# from the frontend silently fail CORS.
+CORS_ORIGIN=https://app.praxistech.academy
+
+THROTTLE_TTL_MS=60000
+THROTTLE_LIMIT=100
+
+# Generate distinct secrets for each — e.g. `openssl rand -hex 64` — never
+# reuse the same value for both, and never reuse a value from any other
+# environment (staging, local dev) in production.
+JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_hex_64_or_longer
+JWT_ACCESS_EXPIRES_IN=15m
+JWT_REFRESH_SECRET=CHANGE_ME_a_different_secret_from_the_access_one
+JWT_REFRESH_EXPIRES_IN=30d
+
+BCRYPT_SALT_ROUNDS=12
+
+# Shared parent domain so the refresh-token cookie reaches both the
+# frontend and API subdomains, e.g. ".praxistech.academy" — leading dot,
+# no scheme, no trailing slash.
+COOKIE_DOMAIN=.praxistech.academy
+
+# --- Payments (ARCA) ---------------------------------------------------------
+# From the issuing bank's merchant onboarding — never invent
+# placeholder-looking values for a real environment.
+ARCA_API_BASE_URL=https://CHANGE_ME.example.com/payment/rest
+ARCA_MERCHANT_LOGIN=CHANGE_ME
+ARCA_MERCHANT_PASSWORD=CHANGE_ME
+# Generate with: openssl rand -hex 32
+ARCA_WEBHOOK_SECRET=CHANGE_ME_generate_a_real_32_byte_hex_secret
+ARCA_RETURN_URL=https://app.praxistech.academy/payment/return
+ARCA_REQUEST_TIMEOUT_MS=15000
+ORDER_EXPIRY_MINUTES=30
+
+# --- Telegram -----------------------------------------------------------------
+# From @BotFather. Treat exactly like a password.
+TELEGRAM_BOT_TOKEN=CHANGE_ME_123456:ABC-your-real-bot-token
+TELEGRAM_BOT_USERNAME=PraxisAcademyBot
+TELEGRAM_API_BASE_URL=https://api.telegram.org
+# Set via setWebhook's secret_token parameter when registering the webhook
+# URL with Telegram. Generate with: openssl rand -hex 32
+TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_generate_a_real_32_byte_hex_secret
+TELEGRAM_REQUEST_TIMEOUT_MS=10000
+TELEGRAM_INVITE_LINK_EXPIRY_MINUTES=1440
+
+# =============================================================================
+# Frontend (Frontend/praxis-web)
+# =============================================================================
+# Baked into the client bundle at IMAGE BUILD TIME (see
+# Frontend/praxis-web/Dockerfile's comment) — changing this value requires
+# `docker compose build frontend` again, not just a container restart, and
+# not just re-running `docker compose up`.
+NEXT_PUBLIC_API_URL=https://api.praxistech.academy
+
+# =============================================================================
+# Backups (ops/backup)
+# =============================================================================
+BACKUP_RETENTION_DAYS=14
+# Standard 5-field cron syntax, UTC (the container has no locale/timezone
+# configured — see docs/BACKUP_STRATEGY.md before changing this if the
+# intent is "3am in a specific timezone").
+BACKUP_SCHEDULE_CRON=0 3 * * *
diff --git a/Admin_Panel_Backend/.dockerignore b/Admin_Panel_Backend/.dockerignore
new file mode 100644
index 0000000..c70c996
--- /dev/null
+++ b/Admin_Panel_Backend/.dockerignore
@@ -0,0 +1,30 @@
+node_modules
+dist
+coverage
+
+# Local env files must never enter the build context — secrets are injected
+# at container runtime via docker-compose's env_file/environment, never
+# baked into an image layer. .env.example is intentionally NOT excluded;
+# it contains no real secrets and documents the required shape.
+.env
+.env.*
+!.env.example
+
+.git
+.gitignore
+.github
+
+*.log
+npm-debug.log*
+
+.vscode
+.idea
+.DS_Store
+
+# Test artifacts and CI config have no place in a production image.
+test
+*.spec.ts
+jest.config.*
+
+README.md
+docs
