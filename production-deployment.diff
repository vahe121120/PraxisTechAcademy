diff --git a/Admin_Panel_Backend/scripts/docker-migrate.sh b/Admin_Panel_Backend/scripts/docker-migrate.sh
new file mode 100755
index 0000000..3303bc0
--- /dev/null
+++ b/Admin_Panel_Backend/scripts/docker-migrate.sh
@@ -0,0 +1,55 @@
+#!/usr/bin/env sh
+set -eu
+
+# -----------------------------------------------------------------------------
+# Runs `prisma migrate deploy` against DATABASE_URL and exits.
+#
+# WHY THIS IS ITS OWN SERVICE, NOT PART OF THE APP CONTAINER'S CMD:
+# `prisma migrate deploy` takes an advisory lock and IS safe to run
+# concurrently from multiple callers — but "safe" isn't the same as
+# "sensible." Baking it into every app replica's startup means N replicas
+# all attempt it on every deploy/restart, N-1 of them block on the lock and
+# log a confusing wait, and a migration failure surfaces as N crash-looped
+# containers instead of one clear failed step your deploy pipeline can gate
+# on. One explicit, single-purpose step is easier to reason about, easier to
+# alert on, and is what `docker compose`'s `depends_on: condition:
+# service_completed_successfully` is specifically designed for (see the
+# `migrate` service in docker-compose.yml).
+#
+# WHY A SEPARATE SCRIPT AND NOT JUST THE RAW COMMAND INLINE IN COMPOSE:
+# so the exact same script runs in CI/CD before a production deploy as runs
+# here — one source of truth for "how does this app migrate," not a command
+# duplicated (and liable to drift) between compose, a CI YAML file, and
+# anyone's terminal history.
+# -----------------------------------------------------------------------------
+
+if [ -z "${DATABASE_URL:-}" ]; then
+  echo "[migrate] FATAL: DATABASE_URL is not set." >&2
+  exit 1
+fi
+
+# DIRECT_URL is required by schema.prisma's datasource block for `migrate
+# deploy` specifically (it must bypass any connection pooler — PgBouncer,
+# RDS Proxy — and talk to the database directly, since migrations use
+# session-level features a transaction-pooled connection can break). Fail
+# loudly here rather than let Prisma's own, less specific error surface
+# first.
+if [ -z "${DIRECT_URL:-}" ]; then
+  echo "[migrate] FATAL: DIRECT_URL is not set (required for migrate deploy — must bypass any connection pooler)." >&2
+  exit 1
+fi
+
+echo "[migrate] Starting: prisma migrate deploy"
+echo "[migrate] Target: $(echo "$DATABASE_URL" | sed -E 's#(://[^:]+:)[^@]+(@)#\1***\2#')"
+
+# `migrate deploy` (not `migrate dev`): the production-safe command. It
+# never generates new migrations, never prompts, never resets data — it
+# only applies pending migration files already committed to
+# prisma/migrations/ in the exact order of their timestamps, and fails
+# loudly (nonzero exit, no partial silent success) if the migrations
+# directory and the database's `_prisma_migrations` history have diverged
+# (e.g. someone hand-edited a shipped migration file after it was already
+# applied elsewhere).
+npx prisma migrate deploy
+
+echo "[migrate] Completed successfully."
