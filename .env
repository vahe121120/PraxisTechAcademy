# =============================================================================
# PraxisTechAcademy — root .env for docker-compose
#
# USAGE:
#   cp .env.example .env
#   # Edit .env — fill in every CHANGE_ME before running docker compose.
#   docker compose up -d
#
# This file is the single source of truth for ALL docker-compose variables.
# Sub-service .env.example files (Admin_Panel_Backend/, Frontend/) document
# the same vars for standalone `npm run dev` runs outside Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=praxis_app
POSTGRES_PASSWORD=qsczdrwsxasdVah$2021
POSTGRES_DB=praxis

# Pooled URL used by the running application.
DATABASE_URL="postgresql://stalker@localhost:5432/praxis_dev?schema=public"

# Direct (non-pooled) URL used by prisma migrate — identical to DATABASE_URL
# in a plain Docker-compose setup (no PgBouncer); differs in production.
DIRECT_URL="postgresql://stalker@localhost:5432/praxis_dev?schema=public"

# -----------------------------------------------------------------------------
# Backend — application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Auth — generate with: openssl rand -hex 64
# Both secrets MUST be different and at least 32 chars (enforced by Joi).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=2bd068c0413cc00775e1ab72937ee0e824bc0d4e8735a2103a20028861f2d3825504a699b01e538518741d158981d13fe70a653738bfce050d16a53a72e46e2f
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=2671ed589837b69dd0ce2c9867e81e6f033bdb5eb08ef464e7732dff8550e702600b68d255acc1cf39c85ed6fdd52ad661f853ffa2e8fdbeb495763cb567d79e
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Leave blank for local dev; set to ".praxis.am" in production.
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Payments (ARCA)
# In local dev these values are fake-but-format-valid so the backend boots.
# Replace with real bank credentials before any payment testing.
# -----------------------------------------------------------------------------
ARCA_API_BASE_URL=https://ipaytest.arca.am/payment/rest
ARCA_MERCHANT_LOGIN=CHANGE_ME
ARCA_MERCHANT_PASSWORD=CHANGE_ME
# openssl rand -hex 32
ARCA_WEBHOOK_SECRET=a3765af1ac143a2ab38df641b34bcfdc0fa42092c9db72b2cf7304d030c10dbb
ARCA_RETURN_URL=http://localhost:3001/payment/return
ARCA_REQUEST_TIMEOUT_MS=15000
ORDER_EXPIRY_MINUTES=30

# -----------------------------------------------------------------------------
# Telegram
# In local dev these values are placeholders so the backend boots.
# Replace with real @BotFather credentials before bot testing.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8105463980:AAE2e4YMNn9BjB706tIFgWUvPwDO1s-zAf4
TELEGRAM_BOT_USERNAME=PraxisAcademyBot
TELEGRAM_API_BASE_URL=https://api.telegram.org
