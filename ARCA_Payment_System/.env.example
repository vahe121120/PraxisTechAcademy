# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins. No wildcard in production —
# the web app's real origin(s) must be listed explicitly.
CORS_ORIGIN=http://localhost:3001

LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
# Pooled connection — used by the running application at request time.
DATABASE_URL="postgresql://praxis_app:CHANGE_ME@localhost:5432/praxis?schema=public"

# Direct (non-pooled) connection — used only by `prisma migrate`. In local
# development this is typically identical to DATABASE_URL; in production,
# behind PgBouncer/RDS Proxy/Supabase pooler, it must point directly at the
# database instance instead of the pooler.
DIRECT_URL="postgresql://praxis_app:CHANGE_ME@localhost:5432/praxis?schema=public"

# -----------------------------------------------------------------------------
# Rate limiting (global default throttle — @nestjs/throttler)
# -----------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Generate distinct, high-entropy secrets — e.g. `openssl rand -hex 64` —
# never reuse the same value for both. Minimum 32 characters, enforced by
# env validation.
JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_hex_64_or_longer
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_a_different_secret_from_the_access_one
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_SALT_ROUNDS=12

# Leave blank in local development. In production, set to the shared parent
# domain (e.g. ".praxis.am") so the refresh-token cookie is sent to both
# app.praxis.am and api.praxis.am.
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Seed script only (prisma/seed.ts) — not read by the running application.
# Creates the first ADMIN account idempotently; safe to leave set after the
# first run since the seed only acts on a fresh, matching, unregistered email.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@praxistech.academy
SEED_ADMIN_PASSWORD=CHANGE_ME_use_a_real_generated_password
SEED_ADMIN_NAME="Praxis Admin"

# -----------------------------------------------------------------------------
# Payments (ARCA)
# -----------------------------------------------------------------------------
# All of these come from the issuing bank's merchant onboarding process —
# never invent placeholder-looking values here for a real environment.
# See src/payments/providers/arca-payment.provider.ts for the parts of this
# integration that still need confirming against that bank's actual API docs
# (exact endpoint paths, callback payload shape, and signature scheme differ
# slightly between Armenian banks that all sit on the same ArCa rail).
ARCA_API_BASE_URL=https://CHANGE_ME.example.com/payment/rest
ARCA_MERCHANT_LOGIN=CHANGE_ME
ARCA_MERCHANT_PASSWORD=CHANGE_ME
# Generate with: openssl rand -hex 32
ARCA_WEBHOOK_SECRET=CHANGE_ME_generate_a_real_32_byte_hex_secret
ARCA_RETURN_URL=https://app.praxistech.academy/payment/return
ARCA_REQUEST_TIMEOUT_MS=15000
ORDER_EXPIRY_MINUTES=30
