# =============================================================================
# PraxisTechAcademy — root .env for docker-compose
#
# USAGE:
#   cp .env.example .env
#   # Edit .env — fill in every CHANGE_ME before running docker compose.
#   docker compose up -d
#
# This file is the single source of truth for ALL docker-compose variables.
# Sub-service .env.example files (Admin_Panel_Backend/, Frontend/) document
# the same vars for standalone `npm run dev` runs outside Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=praxis_app
POSTGRES_PASSWORD=CHANGE_ME_strong_local_db_password
POSTGRES_DB=praxis

# Pooled URL used by the running application.
DATABASE_URL="postgresql://praxis_app:CHANGE_ME_strong_local_db_password@postgres:5432/praxis?schema=public"

# Direct (non-pooled) URL used by prisma migrate — identical to DATABASE_URL
# in a plain Docker-compose setup (no PgBouncer); differs in production.
DIRECT_URL="postgresql://praxis_app:CHANGE_ME_strong_local_db_password@postgres:5432/praxis?schema=public"

# -----------------------------------------------------------------------------
# Backend — application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# -----------------------------------------------------------------------------
# Auth — generate with: openssl rand -hex 64
# Both secrets MUST be different and at least 32 chars (enforced by Joi).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_hex_64_and_paste_here_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_64_and_paste_here_refresh
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Leave blank for local dev; set to ".praxis.am" in production.
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Payments (ARCA)
# In local dev these values are fake-but-format-valid so the backend boots.
# Replace with real bank credentials before any payment testing.
# -----------------------------------------------------------------------------
ARCA_API_BASE_URL=https://ipaytest.arca.am/payment/rest
ARCA_MERCHANT_LOGIN=CHANGE_ME
ARCA_MERCHANT_PASSWORD=CHANGE_ME
# openssl rand -hex 32
ARCA_WEBHOOK_SECRET=CHANGE_ME_32_byte_hex_arca_webhook_secret_here_000000
ARCA_RETURN_URL=http://localhost:3001/payment/return
ARCA_REQUEST_TIMEOUT_MS=15000
ORDER_EXPIRY_MINUTES=30

# -----------------------------------------------------------------------------
# Telegram
# In local dev these values are placeholders so the backend boots.
# Replace with real @BotFather credentials before bot testing.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=0000000000:AAFakeTokenForLocalDevOnlyReplaceMe
TELEGRAM_BOT_USERNAME=PraxisAcademyBot
TELEGRAM_API_BASE_URL=https://api.telegram.org
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_32_byte_hex_telegram_webhook_secret_00000
TELEGRAM_REQUEST_TIMEOUT_MS=10000
TELEGRAM_INVITE_LINK_EXPIRY_MINUTES=1440

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Backup service
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_CRON=0 3 * * *
