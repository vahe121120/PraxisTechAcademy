+/// A section of a Course's curriculum ("Module 1 — Introduction to
+/// Programming"), ordered by `position`. Deleting a Course cascades to its
+/// modules — a module has no meaning detached from its course.
+model CourseModule {
+  id          String   @id @default(uuid()) @db.Uuid
+  courseId    String   @map("course_id") @db.Uuid
+  title       String   @db.VarChar(150)
+  description String
+  position    Int
+  createdAt   DateTime @default(now()) @map("created_at")
+  updatedAt   DateTime @updatedAt @map("updated_at")
+
+  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
+  topics CourseTopic[]
+
+  // A course's modules must have distinct, gap-free-in-intent ordering —
+  // enforced at the position level (exact contiguity is a service-layer
+  // concern on reorder, per the same pattern as CourseGroup's other
+  // ordering-sensitive fields elsewhere in this schema).
+  @@unique([courseId, position])
+  @@index([courseId])
+  @@map("course_modules")
+}
+
+/// A single bullet-point topic within a CourseModule ("Variables", "Loops").
+/// Deliberately just a label + position — topics are display-only content,
+/// not a place for per-topic metadata (that would belong on CourseModule
+/// or a future lesson-level model instead).
+model CourseTopic {
+  id        String   @id @default(uuid()) @db.Uuid
+  moduleId  String   @map("module_id") @db.Uuid
+  label     String   @db.VarChar(200)
+  position  Int
+  createdAt DateTime @default(now()) @map("created_at")
+  updatedAt DateTime @updatedAt @map("updated_at")
+
+  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
+
+  @@unique([moduleId, position])
+  @@index([moduleId])
+  @@map("course_topics")
+}
+
