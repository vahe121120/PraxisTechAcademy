@@ -0,0 +1,62 @@
+import {
+  Body,
+  Controller,
+  Delete,
+  HttpCode,
+  HttpStatus,
+  Param,
+  ParseUUIDPipe,
+  Patch,
+  Post,
+  UseGuards,
+} from '@nestjs/common';
+import { UserRole } from '@prisma/client';
+
+import { Roles } from '../auth/decorators/roles.decorator';
+import { RolesGuard } from '../auth/guards/roles.guard';
+import { CourseModulesService, CourseModuleWithTopics } from './course-modules.service';
+import { CreateCourseModuleDto } from './dto/create-course-module.dto';
+import { ReorderCourseModulesDto } from './dto/reorder-course-modules.dto';
+import { UpdateCourseModuleDto } from './dto/update-course-module.dto';
+
+/**
+ * Admin-only curriculum management. Every route here requires ADMIN — there
+ * is no student-facing endpoint in this controller; students read
+ * curriculum through GET /courses/:id (CoursesController), which already
+ * eager-loads modules/topics ordered by position.
+ *
+ * Route ordering matters: the literal 'reorder' segment is registered
+ * before ':id' for the same reason documented in CoursesController — so it
+ * is never swallowed by the generic id route.
+ */
+@Roles(UserRole.ADMIN)
+@UseGuards(RolesGuard)
+@Controller({ path: 'course-modules', version: '1' })
+export class CourseModulesController {
+  constructor(private readonly courseModulesService: CourseModulesService) {}
+
+  @Post()
+  @HttpCode(HttpStatus.CREATED)
+  create(@Body() dto: CreateCourseModuleDto): Promise<CourseModuleWithTopics> {
+    return this.courseModulesService.createModule(dto);
+  }
+
+  @Patch('reorder')
+  reorder(@Body() dto: ReorderCourseModulesDto): Promise<CourseModuleWithTopics[]> {
+    return this.courseModulesService.reorderModules(dto);
+  }
+
+  @Patch(':id')
+  update(
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() dto: UpdateCourseModuleDto,
+  ): Promise<CourseModuleWithTopics> {
+    return this.courseModulesService.updateModule(id, dto);
+  }
+
+  @Delete(':id')
+  @HttpCode(HttpStatus.NO_CONTENT)
+  remove(@Param('id', ParseUUIDPipe) id: string): Promise<void> {
+    return this.courseModulesService.removeModule(id);
+  }
+}
