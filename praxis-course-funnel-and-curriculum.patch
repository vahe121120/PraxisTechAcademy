+import { Module } from '@nestjs/common';
+
+import { CoursesModule } from '../courses/courses.module';
+import { CourseModulesController } from './course-modules.controller';
+import { CourseModulesService } from './course-modules.service';
+import { CourseTopicsController } from './course-topics.controller';
+
+@Module({
+  // CoursesModule is imported (not just its service reached into) so
+  // CourseModulesService can inject CoursesService for
+  // assertCourseExists — the standard Nest way to reuse another feature
+  // module's exported provider.
+  imports: [CoursesModule],
+  controllers: [CourseModulesController, CourseTopicsController],
+  providers: [CourseModulesService],
+})
+export class CourseModulesModule {}
diff --git a/Admin_Panel_Backend/src/course-modules/course-modules.service.ts b/Admin_Panel_Backend/src/course-modules/course-modules.service.ts
new file mode 100644
index 00000000..14773e0c
--- /dev/null
+++ b/Admin_Panel_Backend/src/course-modules/course-modules.service.ts
@@ -0,0 +1,225 @@
+import { BadRequestException, Injectable, NotFoundException } from '@nestjs/common';
+import { CourseModule as CourseModuleModel, CourseTopic } from '@prisma/client';
+
+import { CoursesService } from '../courses/courses.service';
+import { PrismaService } from '../prisma/prisma.service';
+import { CreateCourseModuleDto } from './dto/create-course-module.dto';
+import { CreateCourseTopicDto } from './dto/create-course-topic.dto';
+import { ReorderCourseModulesDto } from './dto/reorder-course-modules.dto';
+import { ReorderCourseTopicsDto } from './dto/reorder-course-topics.dto';
+import { UpdateCourseModuleDto } from './dto/update-course-module.dto';
+import { UpdateCourseTopicDto } from './dto/update-course-topic.dto';
+
+// Reordering has to move every affected row through a position it doesn't
+// currently occupy, but (courseId, position) / (moduleId, position) are
+// UNIQUE — updating rows one at a time in the new order can transiently
+// collide with a sibling that hasn't been moved yet. Offsetting everything
+// well past any realistic item count first, then assigning the final
+// 0..n-1 positions, guarantees no UNIQUE violation at any intermediate
+// step without needing deferrable constraints (which the migration didn't
+// declare). 100_000 comfortably exceeds ArrayMaxSize(100)/(200) on the
+// reorder DTOs.
+const REORDER_OFFSET = 100_000;
+
+export type CourseModuleWithTopics = CourseModuleModel & { topics: CourseTopic[] };
+
+@Injectable()
+export class CourseModulesService {
+  constructor(
+    private readonly prisma: PrismaService,
+    private readonly coursesService: CoursesService,
+  ) {}
+
+  // ---------------------------------------------------------------------
+  // Modules
+  // ---------------------------------------------------------------------
+
+  async createModule(dto: CreateCourseModuleDto): Promise<CourseModuleWithTopics> {
+    await this.coursesService.assertCourseExists(dto.courseId);
+
+    return this.prisma.$transaction(async (tx) => {
+      const last = await tx.courseModule.findFirst({
+        where: { courseId: dto.courseId },
+        orderBy: { position: 'desc' },
+        select: { position: true },
+      });
+
+      return tx.courseModule.create({
+        data: {
+          courseId: dto.courseId,
+          title: dto.title,
+          description: dto.description,
+          position: (last?.position ?? -1) + 1,
+        },
+        include: { topics: true },
+      });
+    });
+  }
+
+  async updateModule(id: string, dto: UpdateCourseModuleDto): Promise<CourseModuleWithTopics> {
+    if (Object.keys(dto).length === 0) {
+      throw new BadRequestException('At least one field must be provided to update the module.');
+    }
+    await this.assertModuleExists(id);
+
+    return this.prisma.courseModule.update({
+      where: { id },
+      data: {
+        ...(dto.title !== undefined ? { title: dto.title } : {}),
+        ...(dto.description !== undefined ? { description: dto.description } : {}),
+      },
+      include: { topics: { orderBy: { position: 'asc' } } },
+    });
+  }
+
+  async removeModule(id: string): Promise<void> {
+    await this.assertModuleExists(id); // 404s cleanly; topics cascade at the DB level
+    await this.prisma.courseModule.delete({ where: { id } });
+  }
+
+  async reorderModules(dto: ReorderCourseModulesDto): Promise<CourseModuleWithTopics[]> {
+    await this.coursesService.assertCourseExists(dto.courseId);
+
+    return this.prisma.$transaction(async (tx) => {
+      const existing = await tx.courseModule.findMany({
+        where: { courseId: dto.courseId },
+        select: { id: true },
+      });
+      this.assertExactSetMatch(
+        existing.map((m) => m.id),
+        dto.moduleIds,
+        'module',
+      );
+
+      // Phase 1: push every row well clear of the 0..n-1 range this
+      // course's modules are about to occupy, so phase 2 can never collide
+      // with a not-yet-updated sibling.
+      await tx.courseModule.updateMany({
+        where: { courseId: dto.courseId },
+        data: { position: { increment: REORDER_OFFSET } },
+      });
+
+      // Phase 2: assign the final, gap-free ordering.
+      await Promise.all(
+        dto.moduleIds.map((moduleId, index) =>
+          tx.courseModule.update({ where: { id: moduleId }, data: { position: index } }),
+        ),
+      );
+
+      return tx.courseModule.findMany({
+        where: { courseId: dto.courseId },
+        orderBy: { position: 'asc' },
+        include: { topics: { orderBy: { position: 'asc' } } },
+      });
+    });
+  }
+
+  // ---------------------------------------------------------------------
+  // Topics
+  // ---------------------------------------------------------------------
+
+  async createTopic(dto: CreateCourseTopicDto): Promise<CourseTopic> {
+    await this.assertModuleExists(dto.moduleId);
+
+    return this.prisma.$transaction(async (tx) => {
+      const last = await tx.courseTopic.findFirst({
+        where: { moduleId: dto.moduleId },
+        orderBy: { position: 'desc' },
+        select: { position: true },
+      });
+
+      return tx.courseTopic.create({
+        data: { moduleId: dto.moduleId, label: dto.label, position: (last?.position ?? -1) + 1 },
+      });
+    });
+  }
+
+  async updateTopic(id: string, dto: UpdateCourseTopicDto): Promise<CourseTopic> {
+    await this.assertTopicExists(id);
+    return this.prisma.courseTopic.update({ where: { id }, data: { label: dto.label } });
+  }
+
+  async removeTopic(id: string): Promise<void> {
+    await this.assertTopicExists(id);
+    await this.prisma.courseTopic.delete({ where: { id } });
+  }
+
+  async reorderTopics(dto: ReorderCourseTopicsDto): Promise<CourseTopic[]> {
+    await this.assertModuleExists(dto.moduleId);
+
+    return this.prisma.$transaction(async (tx) => {
+      const existing = await tx.courseTopic.findMany({
+        where: { moduleId: dto.moduleId },
+        select: { id: true },
+      });
+      this.assertExactSetMatch(
+        existing.map((t) => t.id),
+        dto.topicIds,
+        'topic',
+      );
+
+      await tx.courseTopic.updateMany({
+        where: { moduleId: dto.moduleId },
+        data: { position: { increment: REORDER_OFFSET } },
+      });
+
+      await Promise.all(
+        dto.topicIds.map((topicId, index) =>
+          tx.courseTopic.update({ where: { id: topicId }, data: { position: index } }),
+        ),
+      );
+
+      return tx.courseTopic.findMany({
+        where: { moduleId: dto.moduleId },
+        orderBy: { position: 'asc' },
+      });
+    });
+  }
+
+  // ---------------------------------------------------------------------
+  // Internal helpers
+  // ---------------------------------------------------------------------
+
+  private async assertModuleExists(id: string): Promise<void> {
+    const exists = await this.prisma.courseModule.findUnique({
+      where: { id },
+      select: { id: true },
+    });
+    if (!exists) {
+      throw new NotFoundException('Course module not found.');
+    }
+  }
+
+  private async assertTopicExists(id: string): Promise<void> {
+    const exists = await this.prisma.courseTopic.findUnique({
+      where: { id },
+      select: { id: true },
+    });
+    if (!exists) {
+      throw new NotFoundException('Course topic not found.');
+    }
+  }
+
+  /**
+   * A reorder submission must be a permutation of exactly the existing
+   * rows — not a superset, subset, or a set containing an id from a
+   * different course/module. Silently accepting a partial list would leave
+   * the omitted row's position undefined relative to the rest; silently
+   * ignoring an extra id would hide a client bug. Both fail loudly instead.
+   */
+  private assertExactSetMatch(existingIds: string[], submittedIds: string[], noun: string): void {
+    const existingSet = new Set(existingIds);
+    const submittedSet = new Set(submittedIds);
+
+    if (existingSet.size !== submittedSet.size) {
+      throw new BadRequestException(
+        `Expected exactly the ${existingSet.size} existing ${noun}(s), got ${submittedSet.size}.`,
+      );
+    }
+    for (const id of submittedSet) {
+      if (!existingSet.has(id)) {
+        throw new BadRequestException(`${id} is not a ${noun} of this parent.`);
+      }
+    }
+  }
+}
