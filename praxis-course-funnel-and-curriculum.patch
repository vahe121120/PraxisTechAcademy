+import { Transform } from 'class-transformer';
+import { IsString, IsUUID, Length } from 'class-validator';
+
+export class CreateCourseTopicDto {
+  @IsUUID('4', { message: 'moduleId must be a valid module id' })
+  moduleId!: string;
+
