index 00000000..43cafc81
--- /dev/null
+++ b/Frontend/praxis-web/lib/api/course-modules.ts
@@ -0,0 +1,71 @@
+import { request } from "@/lib/api/http";
+import type { CourseModule, CourseTopic } from "@/lib/types";
+
+// Admin-only curriculum management (course-modules.controller.ts /
+// course-topics.controller.ts). Students never call these — the public
+// course-detail read (getCourse in courses.ts) already returns modules and
+// topics, ordered, as part of CourseDetail.
+
+export function createCourseModule(
+  payload: { courseId: string; title: string; description: string },
+  accessToken: string,
+) {
+  return request<CourseModule>("/course-modules", { method: "POST", body: payload, accessToken });
+}
+
+export function updateCourseModule(
+  id: string,
+  payload: Partial<{ title: string; description: string }>,
+  accessToken: string,
+) {
+  return request<CourseModule>(`/course-modules/${id}`, {
+    method: "PATCH",
+    body: payload,
+    accessToken,
+  });
+}
+
+export function deleteCourseModule(id: string, accessToken: string) {
+  return request<void>(`/course-modules/${id}`, { method: "DELETE", accessToken });
+}
+
+// `moduleIds` must be exactly the course's existing module ids, in the
+// desired final order — the backend rejects a partial or mismatched set.
+export function reorderCourseModules(
+  courseId: string,
+  moduleIds: string[],
+  accessToken: string,
+) {
+  return request<CourseModule[]>("/course-modules/reorder", {
+    method: "PATCH",
+    body: { courseId, moduleIds },
+    accessToken,
+  });
+}
+
+export function createCourseTopic(
+  payload: { moduleId: string; label: string },
+  accessToken: string,
+) {
+  return request<CourseTopic>("/course-topics", { method: "POST", body: payload, accessToken });
+}
+
+export function updateCourseTopic(id: string, label: string, accessToken: string) {
+  return request<CourseTopic>(`/course-topics/${id}`, {
