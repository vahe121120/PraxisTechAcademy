--- /dev/null
+++ b/Admin_Panel_Backend/src/course-modules/dto/create-course-module.dto.ts
@@ -0,0 +1,24 @@
+import { Transform } from 'class-transformer';
+import { IsString, IsUUID, Length } from 'class-validator';
+
+export class CreateCourseModuleDto {
+  @IsUUID('4', { message: 'courseId must be a valid course id' })
+  courseId!: string;
+
+  @IsString()
+  @Length(2, 150, { message: 'title must be between 2 and 150 characters' })
+  @Transform(({ value }: { value: string }) => value?.trim())
+  title!: string;
+
+  @IsString()
+  @Length(2, 2000, { message: 'description must be between 2 and 2000 characters' })
+  @Transform(({ value }: { value: string }) => value?.trim())
+  description!: string;
+
+  // Intentionally no `position` field here — a new module is always
+  // appended at the end (service computes max(position)+1). Reordering is
+  // a dedicated, explicit action (PATCH /course-modules/reorder) rather
+  // than something a caller can accidentally trigger by guessing a number
+  // on create, which would risk colliding with the (courseId, position)
+  // unique constraint.
+}
